SECRET_KEY=hostel-management-system-secret-key
DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# For localhost you can use MySQL (default) or SQLite.
# Example MySQL:
DB_ENGINE=django.db.backends.mysql
DB_NAME=hostel_management_db
DB_USER=root
DB_PASSWORD=aniketb@123
DB_HOST=127.0.0.1
DB_PORT=3306

# Example SQLite for quick local testing:
# DB_ENGINE=django.db.backends.sqlite3
# SQLITE_NAME=db.sqlite3

MYSQLDUMP_PATH=mysqldump
MYSQL_CLIENT_PATH=mysql

# Deployment only
# DATABASE_URL=
DB_SSL_REQUIRE=False

# Optional auto superuser for deployment/builds
CREATE_SUPERUSER=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me
